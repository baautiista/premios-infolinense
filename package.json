{
  "name": "premios-infolinense",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma oficial de los Premios InfoLinense (premios.infolinense.com)",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply premios-infolinense --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": ">=0.25.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.168.0"
  }
}
